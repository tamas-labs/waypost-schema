{
    "name": "waypost/schema",
    "description": "Waypost shared contract: JSON Schemas (draft 2020-12) for entities, API and chain entries, plus chain, schedule and PIN test vectors.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "Waypost\\Schema\\": "src/"
        }
    },
    "archive": {
        "exclude": [
            "/node_modules",
            "/examples",
            "/scripts",
            "/docs",
            "/lib",
            "/types",
            "/tsconfig.json",
            "/package.json",
            "/package-lock.json"
        ]
    },
    "minimum-stability": "stable"
}
