{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waypost.dev/schema/api/error.json",
  "title": "Error response",
  "description": "Body of every non-2xx API response.",
  "type": "object",
  "required": ["server_time", "error"],
  "properties": {
    "server_time": { "$ref": "../common/server-time.json" },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "$ref": "../common/error-code.json" },
        "message": {
          "description": "Human-readable message in Hungarian, safe to show to the user.",
          "type": "string",
          "minLength": 1
        },
        "details": {
          "description": "Per-field messages (Hungarian), keyed by the dot-separated path of the offending field, e.g. {\"entries.3.seq\": [\"...\"]}. Present for validation_failed, optional otherwise.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
