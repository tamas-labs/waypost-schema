{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waypost.dev/schema/api/sync-push.response.json",
  "title": "POST /sync/push – 200 response",
  "description": "Per-entry result of a push. An entry sent again after it was accepted is accepted again. Error responses use api/error.json.",
  "type": "object",
  "required": [
    "server_time",
    "accepted",
    "last_seq",
    "rejected",
    "media_missing"
  ],
  "properties": {
    "server_time": {
      "$ref": "../common/server-time.json"
    },
    "accepted": {
      "description": "IDs of the entries now stored with verify_status ok (including earlier accepted ones sent again).",
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "$ref": "../common/uuid.json"
      }
    },
    "last_seq": {
      "description": "The server's last verified seq of the device (0 if none yet).",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rejected": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "id",
          "code",
          "expected_seq"
        ],
        "properties": {
          "id": {
            "$ref": "../common/uuid.json"
          },
          "code": {
            "$ref": "../common/error-code.json",
            "enum": [
              "chain_gap",
              "chain_fork",
              "bad_hmac"
            ]
          },
          "expected_seq": {
            "description": "For chain_gap: the seq the server is waiting for; otherwise null.",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "if": {
          "properties": {
            "code": {
              "const": "chain_gap"
            }
          }
        },
        "then": {
          "properties": {
            "expected_seq": {
              "type": "integer"
            }
          }
        },
        "else": {
          "properties": {
            "expected_seq": {
              "type": "null"
            }
          }
        }
      }
    },
    "media_missing": {
      "description": "Photos referenced by an entry of this device that are not uploaded yet; upload them with PUT /media/{id}.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "../common/uuid.json"
      }
    }
  },
  "additionalProperties": false
}
