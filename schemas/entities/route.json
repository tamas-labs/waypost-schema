{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waypost.dev/schema/entities/route.json",
  "title": "Route",
  "description": "A patrol route on a site. Its checkpoints live in immutable route versions. Every property is present; absent values are null.",
  "type": "object",
  "required": [
    "id",
    "site_id",
    "name",
    "order_mode",
    "current_version_id",
    "active",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "$ref": "../common/uuid.json"
    },
    "site_id": {
      "$ref": "../common/uuid.json"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "order_mode": {
      "description": "fixed: checkpoints must be scanned by position; free: any order.",
      "type": "string",
      "enum": [
        "free",
        "fixed"
      ]
    },
    "current_version_id": {
      "anyOf": [
        {
          "$ref": "../common/uuid.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "active": {
      "type": "boolean"
    },
    "created_at": {
      "$ref": "../common/timestamp.json"
    },
    "updated_at": {
      "description": "Last change; drives the pull cursor.",
      "$ref": "../common/timestamp.json"
    }
  },
  "additionalProperties": false
}
