{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waypost.dev/schema/entities/checkpoint.json",
  "title": "Checkpoint",
  "description": "A point on a site identified by an NFC tag and/or a QR code. NFC checkpoints (nfc, nfc_dna) have a tag_uid, QR checkpoints a qr_payload; either kind may carry the other as a fallback. Location is integer-encoded (no floats); lat_e7 and lng_e7 are both set or both null, accuracy_dm only with a location. Every property is present; absent values are null.",
  "type": "object",
  "required": [
    "id",
    "site_id",
    "name",
    "instruction",
    "tag_type",
    "tag_uid",
    "qr_payload",
    "lat_e7",
    "lng_e7",
    "accuracy_dm",
    "photo_media_id",
    "active",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "id": {
      "$ref": "../common/uuid.json"
    },
    "site_id": {
      "$ref": "../common/uuid.json"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "instruction": {
      "anyOf": [
        {
          "description": "What the guard has to check here (Hungarian).",
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "tag_type": {
      "type": "string",
      "enum": [
        "nfc",
        "nfc_dna",
        "qr"
      ]
    },
    "tag_uid": {
      "anyOf": [
        {
          "description": "NFC tag UID: uppercase hex without separators, 4 to 10 bytes. Unique within a site.",
          "type": "string",
          "pattern": "^([0-9A-F]{2}){4,10}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "qr_payload": {
      "anyOf": [
        {
          "description": "waypost:cp:<checkpoint id>:<16-character random code>. Globally unique.",
          "type": "string",
          "pattern": "^waypost:cp:[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}:[A-Za-z0-9]{16}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "lat_e7": {
      "anyOf": [
        {
          "$ref": "../common/lat-e7.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "lng_e7": {
      "anyOf": [
        {
          "$ref": "../common/lng-e7.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "accuracy_dm": {
      "anyOf": [
        {
          "$ref": "../common/accuracy-dm.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "photo_media_id": {
      "anyOf": [
        {
          "$ref": "../common/uuid.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "active": {
      "type": "boolean"
    },
    "created_at": {
      "$ref": "../common/timestamp.json"
    },
    "updated_at": {
      "description": "Last change; drives the pull cursor.",
      "$ref": "../common/timestamp.json"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "tag_type": {
            "enum": [
              "nfc",
              "nfc_dna"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "tag_uid": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tag_type": {
            "const": "qr"
          }
        }
      },
      "then": {
        "properties": {
          "qr_payload": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lat_e7": {
            "type": "null"
          }
        }
      },
      "then": {
        "properties": {
          "lng_e7": {
            "type": "null"
          },
          "accuracy_dm": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "lng_e7": {
            "not": {
              "type": "null"
            }
          }
        }
      }
    }
  ]
}
