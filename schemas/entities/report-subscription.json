{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://waypost.dev/schema/entities/report-subscription.json",
  "title": "Report subscription",
  "description": "A user receives the given report of a site by e-mail. Unique per (user_id, site_id, frequency). Every property is present; absent values are null.",
  "type": "object",
  "required": [
    "id",
    "user_id",
    "site_id",
    "frequency"
  ],
  "properties": {
    "id": {
      "$ref": "../common/uuid.json"
    },
    "user_id": {
      "$ref": "../common/uuid.json"
    },
    "site_id": {
      "$ref": "../common/uuid.json"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "shift",
        "daily",
        "weekly",
        "monthly"
      ]
    }
  },
  "additionalProperties": false
}
